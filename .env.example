ZENMUX_API_KEY=your_zenmux_api_key_here 
# 閘道器位址與 API Key 改由使用者在「設定 → AI 服務連線」自行填寫（存瀏覽器 localStorage），
# 伺服器不再提供，因此不需要這兩個環境變數。
# TokenPay：使用 `openssl rand -base64 32` 生成，仅配置在服务端
TOKENPAY_ENCRYPTION_KEY=
# 稳定的产品归因 URL；生产环境需与 TokenDance 合作后台登记一致
TOKENPAY_APP_URL=https://wolf-cha.com
TOKENPAY_KEY_NAME=Wolfcha TokenPay
# 爱猹收：正式环境使用生产密钥和正式商品权益 ID，不可复用沙箱凭证
WATCHA_PAY_API_KEY=
WATCHA_PAY_ENTITLEMENT_ID=
WATCHA_PAY_BASE_URL=https://pay.watcha.cn
WATCHA_PAY_RETURN_URL=https://wolf-cha.com/?payment=watcha-pay
# MiniMax API 配置
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here
MINIMAX_API_BASE_URL=https://api.minimaxi.com
MINIMAX_TTS_MODEL=speech-01-turbo

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_default_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here 

# 仅用于历史 Stripe 订单回调；新订单已停用
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# 观猹 OAuth2 配置（可选，配置后登录弹窗会显示观猹登录按钮）
NEXT_PUBLIC_WATCHA_CLIENT_ID=your_watcha_client_id_here
WATCHA_CLIENT_SECRET=your_watcha_client_secret_here

NEWAPI_API_KEY=your_newapi_api_key_here
NEWAPI_BASE_URL=your_newapi_url_here

# 推理模型思考量（可選）。閘道器實際看的欄位是 reasoning_effort；
# 逐模型預設值見 src/lib/reasoning-effort.ts（deepseek=none、glm=low、gemma 不送）。
# 逐模型覆寫（優先於內建表）：WOLFCHA_REASONING_EFFORT_MAP="deepseek=none,glm=low,gemma="
# 全域值（只影響內建表沒涵蓋的模型）：none / minimal / low / medium / high
WOLFCHA_REASONING_EFFORT_MAP=
WOLFCHA_REASONING_EFFORT=
# 思考預算（token）：閘道器把 thinking 一併計入 max_tokens，需在內容預算外保留。
WOLFCHA_THINKING_TOKEN_RESERVE=6000
